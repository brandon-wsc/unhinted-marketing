{
  "$defs": {
    "CitedSignal": {
      "description": "User-facing HK market signal card for session source-trace links (ADR 0022).",
      "properties": {
        "signal_id": {
          "title": "Signal Id",
          "type": "string"
        },
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        }
      },
      "required": [
        "signal_id",
        "source",
        "title",
        "url",
        "excerpt"
      ],
      "title": "CitedSignal",
      "type": "object"
    },
    "DraftCopy": {
      "description": "Shared post copy across preview skins (ADR 0001).",
      "properties": {
        "caption": {
          "default": "",
          "title": "Caption",
          "type": "string"
        },
        "hashtags": {
          "items": {
            "type": "string"
          },
          "maxItems": 40,
          "title": "Hashtags",
          "type": "array"
        },
        "cta": {
          "default": "",
          "maxLength": 500,
          "title": "Cta",
          "type": "string"
        }
      },
      "required": [
        "caption",
        "hashtags",
        "cta"
      ],
      "title": "DraftCopy",
      "type": "object"
    },
    "PreviewMediaItem": {
      "description": "One append-only image version referenced by a draft (ADR 0008).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "plan": {
          "additionalProperties": true,
          "title": "Plan",
          "type": "object"
        },
        "format": {
          "anyOf": [
            {
              "enum": [
                "single",
                "comic_4panel"
              ],
              "type": "string"
            },
            {
              "type": "string"
            }
          ],
          "default": "single",
          "title": "Format"
        },
        "role": {
          "default": "primary",
          "title": "Role",
          "type": "string"
        },
        "seq": {
          "default": 0,
          "title": "Seq",
          "type": "integer"
        },
        "status": {
          "default": "ready",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "plan",
        "format",
        "role",
        "seq",
        "status"
      ],
      "title": "PreviewMediaItem",
      "type": "object"
    }
  },
  "description": "Payload for SSE / turn event `preview.updated`.",
  "properties": {
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "approval_token": {
      "minLength": 1,
      "title": "Approval Token",
      "type": "string"
    },
    "image_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Image Url"
    },
    "media": {
      "items": {
        "$ref": "#/$defs/PreviewMediaItem"
      },
      "title": "Media",
      "type": "array"
    },
    "copy": {
      "$ref": "#/$defs/DraftCopy"
    },
    "platform": {
      "default": "instagram",
      "maxLength": 40,
      "title": "Platform",
      "type": "string"
    },
    "source_signal_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Signal Ids",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/CitedSignal"
      },
      "title": "Sources",
      "type": "array"
    }
  },
  "required": [
    "revision",
    "approval_token",
    "image_url",
    "media",
    "copy",
    "platform",
    "source_signal_ids",
    "sources"
  ],
  "title": "PreviewUpdatedData",
  "type": "object"
}

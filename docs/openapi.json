  "components": {
    "schemas": {
      "ConfirmSessionRequest": {
        "properties": {
          "approval_token": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Approval Token"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 200,
            "minLength": 8,
            "title": "Idempotency Key"
          },
          "platform": {
            "type": "string",
            "maxLength": 40,
            "title": "Platform",
            "default": "stub"
          }
        },
        "type": "object",
        "required": [
          "approval_token",
          "idempotency_key"
        ],
        "title": "ConfirmSessionRequest"
      },
      "ConfirmSessionResponse": {
        "properties": {
          "receipt_id": {
            "type": "string",
            "format": "uuid",
            "title": "Receipt Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "tool_name": {
            "type": "string",
            "title": "Tool Name"
          },
          "idempotency_key": {
            "type": "string",
            "title": "Idempotency Key"
          }
        },
        "type": "object",
        "required": [
          "receipt_id",
          "status",
          "tool_name",
          "idempotency_key"
        ],
        "title": "ConfirmSessionResponse"
      },
      "CreateSessionRequest": {
        "properties": {
          "company_id": {
            "type": "string",
            "format": "uuid",
            "title": "Company Id"
          },
          "initial_message": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 8000
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Message"
          }
        },
        "type": "object",
        "required": [
          "company_id"
        ],
        "title": "CreateSessionRequest"
      },
      "DraftCopy": {
        "properties": {
          "caption": {
            "type": "string",
            "title": "Caption",
            "default": ""
          },
          "hashtags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 40,
            "title": "Hashtags"
          },
          "cta": {
            "type": "string",
            "maxLength": 500,
            "title": "Cta",
            "default": ""
          }
        },
        "type": "object",
        "title": "DraftCopy",
        "description": "Shared post copy across preview skins (ADR 0001)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "OrganizationSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ],
        "title": "OrganizationSummary"
      },
      "PostMessageRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "PostMessageRequest"
      },
      "PostMessageResponse": {
        "properties": {
          "session": {
            "$ref": "#/components/schemas/SessionResponse"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/schemas__session__MessageResponse"
            },
            "type": "array",
            "title": "Messages"
          },
          "interrupted": {
            "type": "boolean",
            "title": "Interrupted",
            "default": false
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "revision": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Revision"
          },
          "pending_confirm": {
            "type": "boolean",
            "title": "Pending Confirm",
            "default": false
          },
          "approval_token": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"

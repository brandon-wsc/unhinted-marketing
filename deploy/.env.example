# Deploy env template (ADR 0027). Copy to .env next to the compose files:
#   cp .env.example .env
# docker compose reads .env automatically for ${VAR} interpolation.

# ── Required for docker-compose.external-db.yml (BYO Postgres) ──────────────
# Postgres must have pgvector available (migrations run CREATE EXTENSION).
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/unhinted

# Required in production — generate unique values per deployment:
#   JWT_SECRET:            openssl rand -base64 48
#   BYOK_ENCRYPTION_KEY:   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
BYOK_ENCRYPTION_KEY=

# Public origin of the web app (invite links, OAuth redirects, media URLs).
# All-in-one defaults to http://localhost:8080; external-db requires these.
WEB_BASE_URL=https://marketing.example.com
CORS_ORIGINS=https://marketing.example.com

# ── Optional for docker-compose.yml (all-in-one) ────────────────────────────
# All-in-one auto-generates JWT_SECRET / BYOK_ENCRYPTION_KEY on first boot and
# persists them in the `appdata` volume — set them here only to pin your own.
# Bundled DB credentials (not exposed on a host port; safe local defaults):
# POSTGRES_USER=unhinted
# POSTGRES_PASSWORD=unhinted-local-only
# POSTGRES_DB=unhinted

# ── Both packages ───────────────────────────────────────────────────────────
# Web listen port on the host (nginx inside the container always uses :80).
WEB_PORT=8080

# Image coordinates — override to pull from a different registry/namespace or
# pin a release tag. `docker compose up --build` ignores these and builds local.
# IMAGE_PREFIX=ghcr.io/brandon-wsc
# IMAGE_TAG=onprem

# ── Integrations (all optional; org BYOK keys also settable in /setup) ──────
# OPENAI_API_KEY=
# LLM_API_BASE=                      # OpenAI-compatible proxy (OpenRouter, DeepSeek, …)
# LLM_CHEAP_MODEL=gpt-4o-mini
# LLM_MEDIUM_MODEL=gpt-4o-mini
# LLM_STRONG_MODEL=gpt-4o
# LLM_IMAGE_MODEL=                   # e.g. dall-e-3; "placeholder" mocks URLs
# TAVILY_API_KEY=                    # optional web-search ingest (ADR 0009)
# PUBLISH_ADAPTER=stub               # stub | instagram (ADR 0022)

# ── External-DB package only: optional S3 media (ADR 0024/0025) ─────────────
# S3_BUCKET=
# S3_ENDPOINT_URL=                   # S3-compatible endpoint (path-style)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1
# S3_PUBLIC_BASE_URL=

# Dev database (YOUR_IP:YOUR_PORT)
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_IP:YOUR_PORT/unhinted

# Isolated DB for API integration tests (pytest tests/api). Never point at production.
# Unit tests (tests/unit) do not need this. If unset, API tests are skipped.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_IP:YOUR_PORT/unhinted_test

# App environment: development | production
# production refuses known-default / short JWT_SECRET unless ALLOW_INSECURE_JWT=true
# production also requires BYOK_ENCRYPTION_KEY (a valid Fernet key — see below)
APP_ENV=development
ALLOW_INSECURE_JWT=false

# Deployment mode: cloud | onprem (ADR 0023). Read once at process start and
# treated as immutable for the process lifetime — changing it needs a restart.
# On-prem Docker images bake this via build ARG (default onprem); cloud images
# build with --build-arg DEPLOYMENT_MODE=cloud. SPA equivalent: VITE_DEPLOYMENT_MODE.
DEPLOYMENT_MODE=onprem

# JWT — must be unique random in production (≥32 chars).
# The value below is the published example default (long enough, but not a secret).
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# Auth rate limit (in-memory per client IP on register/login/refresh)
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Org invites — link copy default; optional SMTP relay for on-prem
WEB_BASE_URL=https://unhinted.localhost:5173
EMAIL_BACKEND=link
EMAIL_FROM=noreply@localhost
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=true
INVITE_RATE_LIMIT_ENABLED=true
INVITE_RATE_LIMIT_MAX=20
INVITE_RATE_LIMIT_WINDOW_SECONDS=60
BYOK_PROBE_RATE_LIMIT_ENABLED=true
BYOK_PROBE_RATE_LIMIT_MAX=20
BYOK_PROBE_RATE_LIMIT_WINDOW_SECONDS=60

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://unhinted.localhost:5173

# Cookie (set Secure=true in production behind HTTPS)
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# LLM (env fallback; org BYOK keys encrypted at rest — ADR 0020)
# Fernet KEK. Required when APP_ENV=production. Optional in development until an org saves a key.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BYOK_ENCRYPTION_KEY=
OPENAI_API_KEY=
# OpenAI-compatible proxy (OpenRouter, DeepSeek, Azure, local gateway, …). Leave empty for api.openai.com
LLM_API_BASE=
# Model ids as the provider expects them (e.g. gpt-4o-mini, deepseek-chat).
# When LLM_API_BASE is set, ids are sent as openai/<id> so LiteLLM uses the
# OpenAI-compatible client (avoids native Deepseek routing ignoring the base URL).
LLM_CHEAP_MODEL=gpt-4o-mini
LLM_MEDIUM_MODEL=gpt-4o-mini
LLM_STRONG_MODEL=gpt-4o
# Image generation model (separate from chat tiers). Chat-only ids (DeepSeek,
# gpt-4o-mini, …) will fail with llm.failed — set an image-capable model
# (e.g. dall-e-3) or "placeholder" for mock URLs without calling a provider.
LLM_IMAGE_MODEL=openrouter/bytedance-seed/seedream-4.5
# ANTHROPIC_API_KEY=
# AI Studio only — not Vertex Express (generativelanguage.googleapis.com)
# GEMINI_API_KEY=
# Vertex Express (aiplatform.googleapis.com). Prefer this app-specific env,
# or the SDK pair GOOGLE_API_KEY + GOOGLE_GENAI_USE_VERTEXAI=true.
# VERTEX_AI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=false
LLM_TIMEOUT_SECONDS=45
# Persist every LLM call to llm_call_records (ADR 0005; admin /admin).
LLM_RECORD_ENABLED=true
# Persist graph node-step I/O to session_node_steps (admin Trace viewer).
NODE_TRACE_ENABLED=true

# Media storage — S3-compatible (MinIO via docker compose)
#   docker compose up -d minio minio-init
# Leave S3_ENDPOINT_URL empty to skip upload (data: URLs stay in DB — fine for unit tests).
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=unhinted-media
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/unhinted-media

# Workers
QUESTION_CACHE_TTL_HOURS=12
NEWS_PROMOTE_TRENDS_RANK_MAX=10
NEWS_PROMOTE_WINDOW_HOURS=24
SCHEDULER_HOT_SEARCH_INTERVAL_MINUTES=60
SCHEDULER_QUESTIONS_INTERVAL_HOURS=12

# Tavily (ADR 0009) — optional; session research uses PG ∪ Tavily when set
TAVILY_API_KEY=

# Semantic research gate (ADR 0009) — local FastEmbed ONNX via semantic-router
SEMANTIC_ROUTER_ENABLED=true
# FastEmbed has no intfloat/multilingual-e5-small; default multilingual MiniLM small.
# SEMANTIC_ROUTER_MODEL=intfloat/multilingual-e5-large
SEMANTIC_ROUTER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_ROUTER_SCORE_THRESHOLD=0.5

# Confirm publish adapter (ADR 0022). stub never hits Meta; instagram uses social_accounts.
PUBLISH_ADAPTER=stub
# META_GRAPH_API_VERSION=v22.0

# Product catalog embeddings (COLLECT K4) — same FastEmbed family; empty model → reuse above
PRODUCT_EMBEDDINGS_ENABLED=true
# PRODUCT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Meta OAuth — Instagram Login (real publish, ADR 0022 OAuth slice).
# App Dashboard → Instagram → API setup with Instagram login:
#   Instagram App ID / Secret → META_APP_ID / META_APP_SECRET (not the Facebook App ID)
#   Valid OAuth Redirect URIs = META_OAUTH_REDIRECT_URI (below)
# Local: Instagram Login requires HTTPS (no http://localhost exemption).
# Browse https://unhinted.localhost:5173 (not http://localhost:5173) so the
# CSRF cookie is same-site as Connect. Vite uses TLS when web/certs pems exist.
# If Meta rejects .localhost, use https://localhost:5173/... instead.
# The app requests: instagram_business_basic, instagram_business_content_publish.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=https://unhinted.localhost:5173/api/social/oauth/callback
# Optional: route users back to the web app after connecting (defaults to WEB_BASE_URL)
META_OAUTH_SUCCESS_URL=
